# ============================================================
# Time to Afford — .gitignore
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------- Distribution / Packaging ----------
dist/
build/
*.egg-info/
*.egg
.eggs/

# ---------- Virtual Environment ----------
venv/
.venv/
env/
ENV/

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- pytest ----------
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ---------- mypy ----------
.mypy_cache/

# ---------- Environment ----------
.env
.env.local

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Data — büyük dosyalar repo'da tutulmaz ----------
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# ---------- Logs ----------
*.log
logs/

# ---------- Misc ----------
*.pkl
*.pickle
*.h5
*.hdf5
