# Time to Afford — Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.

# Logging
LOG_LEVEL=INFO

# Data paths
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
EXTERNAL_DATA_DIR=data/external

# Simulation
SIMULATION_NUM_PATHS=10000
SIMULATION_RANDOM_SEED=42
SIMULATION_HORIZON_YEARS=30
